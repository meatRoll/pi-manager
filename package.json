{
  "name": "pi-manager",
  "version": "1.0.0",
  "description": "An in-Pi extension for managing packages, skills, extensions, prompts, themes, and context presets.",
  "pi": {
    "extensions": [
      "./dist/extension.js"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meatRoll/pi-manager.git"
  },
  "homepage": "https://github.com/meatRoll/pi-manager#readme",
  "bugs": "https://github.com/meatRoll/pi-manager/issues",
  "type": "module",
  "bin": {
    "pi-manager": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "pi",
    "install:pi": "npm run build && node dist/install-pi.js",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/test/*.test.js",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md"
  ],
  "private": true,
  "keywords": [
    "pi",
    "pi-package",
    "pi-coding-agent",
    "skills",
    "tui",
    "profile-manager"
  ],
  "license": "MIT",
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@earendil-works/pi-tui": "^1.3.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
